generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  running
  stopped
  failed
  deploying
}

enum ObservedStatus {
  running
  stopped
  failed
  unknown
}

enum ExecutionJobStatus {
  pending
  queued
  running
  succeeded
  failed
  cancelled
}

enum ExecutionJobType {
  reconcile
  deploy
  scale
  update
  retire
}

model Project {
  id            String                  @id @default(cuid())
  name          String
  status        ProjectStatus
  deployments   Int
  desiredStates DesiredState[]
  observations  ActualStateObservation[]
  executionJobs ExecutionJob[]
}

model DesiredState {
  desiredStateId String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id])
  version        Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  data           Json

  @@unique([projectId, version])
}

model ActualStateObservation {
  observationId String         @id @default(cuid())
  projectId     String
  project       Project        @relation(fields: [projectId], references: [id])
  workloadId    String
  source        String
  observedAt    DateTime
  status        ObservedStatus
  createdAt     DateTime       @default(now())
  data          Json

  @@index([projectId, workloadId, observedAt])
}

model ExecutionJob {
  jobId               String              @id @default(cuid())
  projectId           String
  project             Project             @relation(fields: [projectId], references: [id])
  workloadId          String
  desiredStateId      String
  desiredStateVersion Int
  jobType             ExecutionJobType
  status              ExecutionJobStatus
  idempotencyKey      String
  attemptCount        Int                 @default(0)
  maxAttempts         Int                 @default(3)
  correlationId       String?
  failure             Json?
  createdAt           DateTime            @default(now())
  updatedAt           DateTime            @updatedAt
  queuedAt            DateTime?
  startedAt           DateTime?
  finishedAt          DateTime?

  @@unique([idempotencyKey])
  @@index([projectId, status])
  @@index([projectId, workloadId, updatedAt])
  @@index([projectId, workloadId, desiredStateId, status])
}