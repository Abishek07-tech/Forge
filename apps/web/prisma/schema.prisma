generator client {
  provider = "prisma-client"
  output   = "../generated/prisma"
}

datasource db {
  provider = "postgresql"
}

enum ProjectStatus {
  running
  stopped
  failed
  deploying
}

enum ObservedStatus {
  running
  stopped
  failed
  unknown
}

model Project {
  id            String                  @id @default(cuid())
  name          String
  status        ProjectStatus
  deployments   Int
  desiredStates DesiredState[]
  observations  ActualStateObservation[]
}

model DesiredState {
  desiredStateId String   @id @default(cuid())
  projectId      String
  project        Project  @relation(fields: [projectId], references: [id])
  version        Int
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
  data           Json

  @@unique([projectId, version])
}

model ActualStateObservation {
  observationId String         @id @default(cuid())
  projectId     String
  project       Project        @relation(fields: [projectId], references: [id])
  workloadId    String
  source        String
  observedAt    DateTime
  status        ObservedStatus
  createdAt     DateTime       @default(now())
  data          Json

  @@index([projectId, workloadId, observedAt])
}